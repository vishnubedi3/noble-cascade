+name: CI Trust Hardened
+
+# Master Prompt IV — Repository-governance workflow (activated 2026-09-25).
+# Relocated from docs/ci-hardened.yml to .github/workflows/ci-hardened.yml so
+# GitHub Actions actually executes it. Self-integrity checks below still pin to
+# .github/workflows/ci-hardened.yml. See docs/ci-activation.md.
+
+on:
+  push:
+    paths: [".github/workflows/**", "noble/**", "tests/**", "pyproject.toml", "requirements*.lock"]
+  pull_request:
+    paths: [".github/workflows/**", "noble/**", "tests/**", "pyproject.toml", "requirements*.lock"]
+
+permissions:
+  contents: read
+
+jobs:
+  validate:
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    permissions:
+      contents: read
+      # no write, no id-token unless needed for provenance
+    steps:
+      # 1. Workflow integrity: pinned SHAs, no persistence of credentials
+      - name: Checkout (pinned SHA, no credentials)
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2 pinned 2024-12-13
+        with:
+          persist-credentials: false
+          fetch-depth: 0
+
+      - name: Verify workflow integrity (no unreviewed workflow change)
+        run: |
+          echo "Workflow SHA: $(sha256sum .github/workflows/ci-hardened.yml | cut -d' ' -f1)"
+          git log --oneline -1 -- .github/workflows/
+          # fail if workflow contains risky patterns
+          # Trigger-key match only, so this self-check cannot match its own text.
+          if grep -rnE "^[[:space:]]+pull_request_target[[:space:]]*:" .github/workflows/; then echo "forbidden pull_request_target trigger"; exit 1; fi
+          if grep -rn "persist-credentials:[[:space:]]*true" .github/workflows/ | grep -v "grep -rn"; then echo "persist-credentials must be false"; exit 1; fi
+          # every third-party action must be pinned to an immutable 40-hex SHA
+          if grep -rnE "uses:[[:space:]]*[^[:space:]#]+@v[0-9]" .github/workflows/; then echo "moving action tag found; pin to immutable SHA"; exit 1; fi
+          # top-level permissions must be minimal (contents: read)
+          python - <<'PYEOF'
+          import sys
+          from pathlib import Path as _P
+          bad = []
+          for wf in sorted(_P(".github/workflows").glob("*.yml")):
+              top = wf.read_text(encoding="utf-8").split("jobs:")[0]
+              if "permissions:" not in top or "contents: read" not in top:
+                  bad.append(f"{wf}: top-level permissions must include 'contents: read'")
+          if bad:
+              print("\n".join(bad))
+              sys.exit(1)
+          print("Workflow integrity: PASS")
+          PYEOF
+
+      # 2. Dependency updates: hash-pinned, verify
+      - name: Python 3.11 (pinned)
+        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
+        with:
+          python-version: '3.11'
+          cache: 'pip'
+          cache-dependency-path: 'requirements-dev.lock'
+
+      - name: Install hash-locked dependencies (reproducible)
+        run: |
+          python -m pip install --upgrade pip --quiet
+          pip hash-checking || true
+          python -m pip install --require-hashes -r requirements-dev.lock
+          python -m pip install -e . --no-deps --no-build-isolation
+          pip freeze | sort > /tmp/installed.txt
+          cat /tmp/installed.txt
+
+      # 3. Cache poisoning protection: cache key includes lock hash
+      - name: Cache verify (poisoning protection)
+        run: |
+          echo "Cache key: $(sha256sum requirements-dev.lock | cut -d' ' -f1)"
+          python -c "import hashlib, pathlib; print(hashlib.sha256(pathlib.Path('requirements-dev.lock').read_bytes()).hexdigest())"
+
+      # 4. Syntax, lint, format, type, and then tests (fail-closed)
+      - name: Lint & type (deterministic)
+        run: |
+          python -m compileall -q noble agent-skills
+          ruff check noble tests
+          ruff format --check noble tests
+          mypy noble
+
+      - name: Tests (unit, integration, security, invariant)
+        run: python -m pytest -q
+
+      # 5. Secret exposure protection: no secrets in env, scan without network
+      - name: Secret exposure check (no secrets in workflow)
+        run: |
+          if env | grep -i "secret\|token\|password"; then echo "secrets in env!"; env | sed 's/=.*/=***/'; exit 1; fi
+          echo "No secrets in env: PASS"
+        env:
+          DUMMY: "test"
+
+      - name: Secret candidate scan (offline)
+        run: |
+          detect-secrets scan --no-verify --all-files noble tests agent-skills docs config > /tmp/noble-secrets.json
+          python - <<'PY'
+          import json
+          data = json.load(open('/tmp/noble-secrets.json'))
+          candidates = sum(len(rows) for rows in data.get('results', {}).values())
+          print(f'Secret candidates: {candidates}')
+          if candidates:
+              raise SystemExit(1)
+          print('Secret scan: PASS')
+          PY
+
+      # 6. Artifact tampering protection: build + hash + provenance
+      - name: Build & provenance
+        run: |
+          python -m pip wheel . --no-deps --wheel-dir /tmp/noble-wheel
+          sha256sum /tmp/noble-wheel/* > /tmp/wheel.sha256
+          cat /tmp/wheel.sha256
+          python -m noble release --create --json | tee /tmp/release.json
+          ls -lh release/
+          cat release/RELEASE.json
+          python -m noble sbom --json >/dev/null
+          cat release/SBOM.spdx.json | head -n 20
+          python -m noble provenance --json | head -n 20
+
+      - name: SBOM & provenance verification
+        run: |
+          test -f release/SBOM.spdx.json
+          test -f release/SBOM.cyclonedx.json
+          test -f release/PROVENANCE.json
+          python -c "import json; d=json.load(open('release/SBOM.spdx.json')); assert d['spdxVersion']=='SPDX-2.3'"
+          python -c "import json; d=json.load(open('release/SBOM.cyclonedx.json')); assert d['bomFormat']=='CycloneDX'"
+          echo "SBOM: PASS"
+
+      # 7. Supply chain verification
+      - name: Supply chain verification
+        run: |
+          python -m noble supply-chain --json
+          python -m noble drift --json
+          python -m noble ledger --verify --json
+          python -m noble audit --verify
+          python -m noble spec --verify
+
+      # 7b. Repository governance verification (Master Prompt IV)
+      - name: Repository governance verification (baseline + workflow audit)
+        run: |
+          python -m noble governance --baseline-verify --json
+          python -m noble governance --workflow-audit --json
+          python -m noble governance --pr-analysis --json | head -n 60
+
+      # 8. Governance certification
+      - name: Governance certification (must be CERTIFIED)
+        run: |
+          python -m noble certify --json | tee /tmp/certify.json
+          python -c "import json; d=json.load(open('/tmp/certify.json')); assert d['status']=='CERTIFIED', d"
+          cat /tmp/certify.json
+
+      # 9. Audit-pack offline verification
+      - name: Audit pack offline verification
+        run: |
+          python -m noble audit-pack --output /tmp/audit-pack-test
+          ls -lh /tmp/audit-pack-test/
+          bash /tmp/audit-pack-test/verification.sh
+
+      # 10. Verify-everything.sh (one-command external verification)
+      - name: One-command external verification
+        run: bash ./verify-everything.sh 2>&1 | tail -n 100
+
+      # 11. Upload artifact with pinned digest (tamper-evident)
+      - name: Upload release artifact (tamper-evident)
+        if: always()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
+        with:
+          name: noble-release-${{ github.sha }}
+          path: |
+            release/
+            audit-pack/
+            /tmp/wheel.sha256
+            /tmp/certify.json
+          retention-days: 7
