+         "release_configuration": {
+             "release_dir": "release/",
+@@ -197,6 +216,7 @@ def verify_baseline(workspace_root: Path | None = None) -> dict[str, Any]:
+         "worker_digest",
+         "verification_script_hash",
+         "governance_module_hash",
++        "release_machinery_hashes",
+         "classification_hash",
+     ):
+         if stored.get(key) != current.get(key):
